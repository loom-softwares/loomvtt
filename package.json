{
  "name": "loomvtt",
  "version": "1.0.0-alpha.0",
  "type": "module",
  "author": "Rob Oliveira",
  "description": "A Virtual Tabletop application for tabletop role-playing games.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sammore2/LoomVTT.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "npm run build:sdk && concurrently --names \"SERVER,CLIENT\" --prefix-colors \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:sdk": "node scripts/sync-sdk-shared-fields.mjs && tsc -p packages/sdk/tsconfig.json --watch",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:sdk": "node scripts/sync-sdk-shared-fields.mjs && tsc -p packages/sdk/tsconfig.json",
    "build": "npm run build:sdk && npm run build:client && npm run build:server",
    "package:server": "node scripts/package-server.mjs",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "audit:docs": "node scripts/audit-comparativo.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "create:ruleset": "node scripts/create-loom-package.mjs ruleset",
    "create:addon": "node scripts/create-loom-package.mjs addon",
    "validate:ruleset": "node tools/validate-system.mjs",
    "electron:start": "node scripts/electron-start.mjs",
    "electron:build:win": "node scripts/electron-build.mjs --win",
    "electron:build:linux": "node scripts/electron-build.mjs --linux"
  },
  "dependencies": {
    "@spd789562/particle-emitter": "^1.0.2",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "cannon-es": "^0.20.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "earcut": "^3.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.0.0",
    "jquery": "^3.7.1",
    "js-angusj-clipper": "^1.3.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pixi.js": "^8.9.2",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-model": "^1.23.0",
    "prosemirror-schema-basic": "^1.2.3",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.34.3",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/handlebars": "^4.0.40",
    "@types/jquery": "^4.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.14",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "lucide-static": "^1.32.0",
    "pino-pretty": "^13.1.3",
    "simple-icons": "^16.28.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.loomvtt.app",
    "productName": "LoomVTT",
    "files": [
      "dist/server/**",
      "dist/shared/**",
      "dist/client/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "dist/client/images/**",
      "dist/client/icons/**",
      "dist/client/cursors/**",
      "dist/client/fonts/**",
      "dist/client/webfonts/**",
      "dist/client/sounds/**",
      "dist/client/bgs/**",
      "dist/client/cards/**",
      "dist/client/ui/**",
      "dist/client/weather/**",
      "dist/client/toolclips/**",
      "dist/client/css/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/images/loom-logo.png"
    }
  }
}
